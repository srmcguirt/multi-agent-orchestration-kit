{
  "name": "@srmcguirt/multi-agent-kit",
  "version": "1.0.1",
  "description": "Production-ready multi-agent orchestration kit for Claude \u2014 pipeline, fan-out, and supervisor patterns with shared memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "example:research": "node --env-file=.env dist/examples/research-pipeline.js",
    "example:fanout": "node --env-file=.env dist/examples/fan-out-analysis.js",
    "example:supervisor": "node --env-file=.env dist/examples/supervised-workflow.js",
    "test": "npx tsx tests/shared-memory.test.ts && npx tsx tests/orchestrator.test.ts && npx tsx tests/patterns.test.ts",
    "test:memory": "npx tsx tests/shared-memory.test.ts",
    "test:orchestrator": "npx tsx tests/orchestrator.test.ts",
    "test:patterns": "npx tsx tests/patterns.test.ts"
  },
  "keywords": [
    "claude",
    "anthropic",
    "multi-agent",
    "ai-agents",
    "orchestration",
    "mcp",
    "llm",
    "typescript"
  ],
  "author": "Shane McGuirt",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/srmcguirt/multi-agent-orchestration-kit"
  }
}
